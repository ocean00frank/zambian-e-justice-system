# Generate a fresh production secret with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=development-only-replace-before-deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
TIME_ZONE=Africa/Lusaka

# Leave DB_NAME blank to use the local SQLite development database.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Set true only when a trusted reverse proxy overwrites X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=false

# Configure SMTP to enable email notifications. In-app alerts work without SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.org
